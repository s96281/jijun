# ==============================================================================
# Android Release Signing Configuration Example
# ------------------------------------------------------------------------------
# 複製此檔案為 `android/keystore.properties` (或專案根目錄的 `keystore.properties`)
# 並填入您的私鑰檔案路徑與密碼，Gradle 即會在 `assembleRelease` 時自動簽署 APK / AAB。
# 
# 注意：`keystore.properties` 已被加入 .gitignore，請勿將包含真實密碼的檔案提交至 Git！
# ==============================================================================

# 金鑰庫檔案路徑 (支援相對於此檔的相對路徑或絕對路徑，例如 ../release.keystore 或 release.keystore)
storeFile=../release.keystore

# 金鑰庫密碼
storePassword=your_keystore_password_here

# 金鑰別名
keyAlias=easyaccounting

# 私鑰密碼 (PKCS12 格式通常與 storePassword 相同)
keyPassword=your_keystore_password_here
